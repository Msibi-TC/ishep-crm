SESSION_SECURE=true
SESSION_SAMESITE=Lax
DOCUMENT_PRIVATE_ROOT=/home/DIRECTADMIN_USER/domains/DOMAIN/ishep-preview/storage/private/documents
LOG_PATH=/home/DIRECTADMIN_USER/domains/DOMAIN/ishep-preview/storage/logs/app.log
MAIL_DRIVER=log
MAIL_HOST=smtp.example.com
