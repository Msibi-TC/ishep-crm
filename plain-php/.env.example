APP_ENV=staging
APP_DEBUG=false
APP_URL=https://preview.example.com
APP_TIMEZONE=Africa/Johannesburg
APP_KEY=replace_with_a_random_secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ishep_crm
DB_USERNAME=ishep_app
DB_PASSWORD=change_me
SESSION_NAME=ishep_plain_session
